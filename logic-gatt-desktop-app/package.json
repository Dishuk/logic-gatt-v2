{
	"name": "logic-gatt-desktop-app",
	"version": "1.0.1",
	"description": "LogicGATT desktop controller — an Electrobun app that drives the phone's BLE GATT server over Wi-Fi.",
	"license": "MIT",
	"author": "Dmytro Hranchak",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary && bun scripts/embed-installer-icon.ts canary",
		"build:stable": "vite build && electrobun build --env=stable && bun scripts/embed-installer-icon.ts stable",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.0",
		"@codemirror/commands": "^6.10.1",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/state": "^6.5.4",
		"@codemirror/view": "^6.39.12",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"bonjour-service": "^1.4.3",
		"codemirror": "^6.0.2",
		"electrobun": "1.18.1",
		"lucide-react": "^0.563.0",
		"qrcode.react": "^4.2.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"serialport": "^13.0.0",
		"thememirror": "^2.0.1",
		"ws": "^8.21.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"concurrently": "^9.1.0",
		"jsdom": "^27.0.1",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.4.16",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vitest": "^3.2.4"
	}
}

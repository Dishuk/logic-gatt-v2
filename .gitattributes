# Normalize line endings: LF in the repo, auto on checkout.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Treat these as binary (never normalized/diffed as text)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.ttf  binary
*.otf  binary
*.woff  binary
*.woff2 binary
*.jks  binary
*.keystore binary
